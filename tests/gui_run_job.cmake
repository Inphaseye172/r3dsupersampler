# ctest -P script: synth a clip, write a job with r3dss-cli scan, run it with r3dss-gui --run-job.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(rc "${rc}" PARENT_SCOPE)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()
run("${CLI}" synth "${WORK}/in/C001" --width 640 --height 360 --frames 3 --audio-channels 2)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "synth failed (${rc}): ${out} ${err}")
endif()
run("${CLI}" scan "${WORK}/in" -o "${WORK}/out" --size 320x180 --write-job "${WORK}/job.json")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "scan failed (${rc}): ${out} ${err}")
endif()
run("${GUI}" --run-job "${WORK}/job.json")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "r3dss-gui --run-job exited ${rc}: ${out} ${err}")
endif()
if(NOT out MATCHES "1 done, 0 failed")
  message(FATAL_ERROR "unexpected summary: ${out}")
endif()
file(GLOB frames "${WORK}/out/C001_320x180_lossless/*.dng")
list(LENGTH frames n)
if(NOT n EQUAL 3)
  message(FATAL_ERROR "expected 3 output frames, found ${n}: ${out}")
endif()
# A second run must skip the complete output (exit 0), and nothing partial may be left.
run("${GUI}" --run-job "${WORK}/job.json")
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "re-run exited ${rc}: ${out}")
endif()
file(GLOB partial "${WORK}/out/*.partial")
if(partial)
  message(FATAL_ERROR "partial output left: ${partial}")
endif()
